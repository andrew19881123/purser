{
  "name": "Purser Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {"version": "1.98.1"},
    "ghcr.io/devcontainers/features/go:1": {"version": "1.27.1"},
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "make setup && echo 'source ./env.sh' >> ~/.bashrc",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "golang.go", "ms-vscode.vscode-typescript-next"]
    }
  },
  "forwardPorts": [8080, 9443, 50151, 8000]
}
