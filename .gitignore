# --- Project-local toolchain (installed by `make setup`) ---
# Rust, Go, buf and all their caches live here. Never committed (~3GB).
.toolchain/

# --- Rust ---
target/
**/target/

# --- Go ---
# Build/test binaries. NOTE: generated *.pb.go under go/gen/ ARE committed on
# purpose so downstream modules build without first running `make gen`.
*.test
*.out
# `go build ./...` drops a compiled executable in each main-package module root.
/go/planner/planner
/go/controlplane/controlplane

# --- Node / UI ---
node_modules/
ui/dist/
ui/build/

# --- Built binaries ---
/bin/

# --- Release staging (scripts/build-release.sh) ---
/dist/

# --- Runtime state (NEVER commit — may contain keys/tokens) ---
*.db
*.sqlite
*.sqlite3
*-registry.db
pki-state/
**/pki-state/

# --- Enterprise license signing keys (NEVER commit — private key material) ---
# The public key is embedded in source (license.DevPublicKeyBase64); the private
# half stays out of the repo. `purser-license keygen` writes to *.ed25519.key.
*.ed25519.key
license-signing-*.pem
license-signing.key

# --- Internal solution-design & strategy docs (kept local, not published) ---
docs/
# Post-mortems and decision docs ARE versioned (contributor knowledge)
!docs/postmortems/
# Exception: published website documentation is tracked in website/
!website/docs/

# --- Misc ---
*.tmp
*.log
*.swp
.DS_Store
