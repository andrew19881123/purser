# /etc/purser/agent.env — managed by Ansible (purser_agent role).
# Permissions: 0640, owner root:purser. Never commit this file — it holds the join token.

# Control plane gRPC endpoint (RegistrationService: Join / Heartbeat)
PURSER_CONTROL_PLANE_ADDR={{ purser_control_plane_addr }}

# One-time join token issued by the control plane (POST /api/v1/join-token)
PURSER_JOIN_TOKEN={{ purser_join_token }}

# Logical cluster this node joins — must match the control plane's cluster_id
PURSER_CLUSTER_ID={{ purser_cluster_id }}

# gRPC bind address for AgentService (control-plane -> agent traffic)
# SECURITY: bind on a TRUSTED-SUBNET interface, never a public one — the
# inference engine worker is NOT sandboxed.
PURSER_AGENT_BIND={{ purser_agent_bind }}

# Port the local inference engine serves the OpenAI-compatible API on
PURSER_INFERENCE_PORT={{ purser_inference_port }}

# Engine backend: "mock" (default, no GPU required) or "llamacpp"
PURSER_ENGINE_BACKEND={{ purser_engine_backend }}

{% if purser_llamacpp_bin | length > 0 %}
# Path to the llama.cpp server binary (required when engine_backend=llamacpp)
PURSER_LLAMACPP_BIN={{ purser_llamacpp_bin }}
{% endif %}

{% if purser_agent_advertised_addr | length > 0 %}
# Explicit address the control plane uses to reach this node's AgentService
PURSER_AGENT_ADVERTISED_ADDR={{ purser_agent_advertised_addr }}
{% endif %}

{% if purser_inference_advertised_addr | length > 0 %}
# Explicit address the gateway uses for inference requests from this node
PURSER_INFERENCE_ADVERTISED_ADDR={{ purser_inference_advertised_addr }}
{% endif %}

# Directory for AES-256-GCM encrypted secret files (join token cert, mTLS certs)
PURSER_SECRET_STORE_DIR={{ purser_secret_store_dir }}

{% if purser_secret_key | length > 0 %}
# 32-byte AES-256 key (hex or base64). When set, the agent does not generate a key file.
PURSER_SECRET_KEY={{ purser_secret_key }}
{% endif %}

# Heartbeat cadence in seconds
PURSER_HEALTH_INTERVAL_SECS={{ purser_health_interval_secs }}

{% if purser_seeds | length > 0 %}
# Extra discovery seed peers (comma-separated host:port) beyond LAN mDNS
PURSER_SEEDS={{ purser_seeds }}
{% endif %}

# Log level
RUST_LOG={{ purser_rust_log }}
