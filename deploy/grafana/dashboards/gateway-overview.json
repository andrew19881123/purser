          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(purser_gateway_time_to_first_token_seconds_bucket[$__rate_interval])) by (le, model))",
          "legendFormat": "p99 {{model}}",
          "refId": "B"
