# Purser Agent — environment file (example).
#
# Install to /etc/purser/agent.env and lock it down: it carries a join token.
#     sudo install -m 640 -o root -g purser agent.env.example /etc/purser/agent.env
# Referenced by EnvironmentFile= in purser-agent.service (KEY=value, no quotes).

# gRPC bind address for AgentService (control-plane -> agent traffic).
# SECURITY: bind on a TRUSTED-SUBNET interface, never a public one — the
# inference engine worker is NOT sandboxed. Default: 0.0.0.0:50151.
PURSER_AGENT_BIND=0.0.0.0:50151

# Port the local inference engine serves the OpenAI-compatible API on.
PURSER_INFERENCE_PORT=8000

# Control-plane RegistrationService address (Join/Heartbeat): the control
# plane's gRPC endpoint (its PURSER_GRPC_ADDR, default :9443).
PURSER_CONTROL_PLANE_ADDR=http://cp.internal:9443

# Logical cluster this node joins. Must match the control plane's cluster id.
PURSER_CLUSTER_ID=default

# One-time join token issued by the control plane (POST /api/v1/join-token).
PURSER_JOIN_TOKEN=replace-me

# Explicit host:port the control plane should reach this agent at. Leave unset
# to derive from PURSER_AGENT_BIND (primary local IPv4 when bound to 0.0.0.0).
#PURSER_AGENT_ADVERTISED_ADDR=192.168.1.10:50151

# Explicit host:port where this node serves inference, as seen by the gateway.
# Leave unset to derive from the advertised host + PURSER_INFERENCE_PORT.
#PURSER_INFERENCE_ADVERTISED_ADDR=192.168.1.10:8000

# --- Optional / advanced ----------------------------------------------------
# Stable node id (normally assigned by the control plane at Join).
#PURSER_NODE_ID=
# Heartbeat cadence in seconds (default 5).
#PURSER_HEALTH_INTERVAL_SECS=5
# Engine backend. Only "mock" is registered today (default); real GPU engines
# register here without changing the service.
#PURSER_ENGINE_BACKEND=mock
# Extra discovery seed peers (host:port list) in addition to LAN mDNS discovery.
#PURSER_SEEDS=
