# Purser Control Plane — environment file (example).
#
# Install to /etc/purser/control-plane.env and lock it down: it may carry a
# gateway token and an enterprise license key.
#     sudo install -m 640 -o root -g purser control-plane.env.example /etc/purser/control-plane.env
# Referenced by EnvironmentFile= in purser-control-plane.service.

# Management REST API listen address (/api/v1). Default :8080.
PURSER_ADDR=:8080

# RegistrationService gRPC listen address (agent Join/Heartbeat). Default :9443.
PURSER_GRPC_ADDR=:9443

# SQLite registry file. Under the systemd sandbox (ProtectSystem=strict) this
# MUST live in the writable StateDirectory, /var/lib/purser.
PURSER_DB=/var/lib/purser/purser-registry.db

# Internal CA key/cert persistence directory. Also under the StateDirectory.
PURSER_PKI_DIR=/var/lib/purser/pki-state

# Cluster identifier echoed in join tokens. Default "default".
PURSER_CLUSTER_ID=default

# --- Gateway route sync (optional) ------------------------------------------
# Gateway base URL the orchestrator pushes routes to. Unset = no gateway sync.
#PURSER_GATEWAY_ADDR=http://127.0.0.1:8081
# Shared secret for route sync; MUST equal the gateway's
# PURSER_GATEWAY_INTERNAL_TOKEN.
#PURSER_GATEWAY_TOKEN=change-me-internal-token

# AgentService port the orchestrator dials on each node. 0 = default 50151.
#PURSER_AGENT_PORT=0

# --- Enterprise (optional) --------------------------------------------------
# Enterprise license key, verified OFFLINE against an embedded public key (no
# phone-home). Unset = community edition. A present-but-invalid key is fatal
# by design, so a misconfigured deployment fails loud.
#PURSER_LICENSE_KEY=
