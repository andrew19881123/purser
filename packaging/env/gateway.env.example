# Purser API Gateway — environment file (example).
#
# Install to /etc/purser/gateway.env and lock it down: it carries client API
# keys and the internal route-sync token.
#     sudo install -m 640 -o root -g purser gateway.env.example /etc/purser/gateway.env
# Referenced by EnvironmentFile= in purser-gateway.service.

# MANDATORY. Bind IP and TCP port — the gateway refuses to start without both.
PURSER_GATEWAY_HOST=0.0.0.0
PURSER_GATEWAY_PORT=8081

# Shared secret protecting route-sync (PUT/DELETE /api/v1/routes). MUST equal
# the control plane's PURSER_GATEWAY_TOKEN. Unset = route-sync DISABLED.
PURSER_GATEWAY_INTERNAL_TOKEN=change-me-internal-token

# Comma-separated client API keys (Bearer tokens). Unset = OPEN DEV MODE (any
# non-empty bearer token is accepted) — DO NOT leave unset in production.
PURSER_GATEWAY_API_KEYS=change-me-key-1,change-me-key-2

# --- TLS (optional; actual TLS termination is a phase-2 concern) ------------
# Both must be set to be picked up.
#PURSER_GATEWAY_TLS_CERT=/etc/purser/tls/gateway.crt
#PURSER_GATEWAY_TLS_KEY=/etc/purser/tls/gateway.key

# --- Upstream timeouts (optional, milliseconds) -----------------------------
#PURSER_GATEWAY_UPSTREAM_CONNECT_MS=2000
#PURSER_GATEWAY_UPSTREAM_TTFB_MS=30000
#PURSER_GATEWAY_UPSTREAM_IDLE_MS=60000

# --- Quota / rate limiting (optional; 0/unset = disabled) -------------------
#PURSER_GATEWAY_TOKENS_PER_MIN=0
#PURSER_GATEWAY_MAX_CONCURRENT=0
#PURSER_GATEWAY_MAX_INFLIGHT=0
#PURSER_GATEWAY_RETRY_AFTER_SECS=1
